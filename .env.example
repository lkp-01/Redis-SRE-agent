# Agent 的资源、target 目录和 Thread 数据应使用独立 Redis，不要指向下方 Docker 诊断节点。
REDIS_URL=

# Prometheus provider 只在调用指标工具时访问该地址；集成测试还需要显式开关。
TOOLS_PROMETHEUS_URL=http://127.0.0.1:19090
TOOLS_PROMETHEUS_DISABLE_SSL=false
RUN_PROMETHEUS_INTEGRATION=0

# Loki provider 只在调用日志工具时访问该地址；默认 selector 对应本地 Alloy 稳定标签。
TOOLS_LOKI_URL=http://127.0.0.1:3100
TOOLS_LOKI_TIMEOUT=30
TOOLS_LOKI_DEFAULT_SELECTOR={job="redis"}
TOOLS_LOKI_TENANT_ID=
RUN_LOKI_INTEGRATION=0

# 本机设置了 HTTP(S)_PROXY 时，让本地观测服务绕过代理。
NO_PROXY=127.0.0.1,localhost

# DeepSeek 使用 OpenAI-compatible 协议，因此沿用 original 的 OPENAI_* 配置名。
# 请复制为 .env 后在本地填写真实密钥；不要提交 .env。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_MODEL_MINI=deepseek-v4-flash
OPENAI_MODEL_NANO=deepseek-v4-flash
LLM_TIMEOUT=180
LLM_FAILOVER_ENABLED=true
DEEPSEEK_THINKING_MODE=disabled

# 只有显式开启时，integration 测试才会访问真实 DeepSeek API。
RUN_DEEPSEEK_LIVE_TESTS=0

# RAG 默认关闭。embedding 凭据与上面的 DeepSeek chat 凭据完全独立，不能互相回退。
RAG_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_DIM=1536
EMBEDDINGS_CACHE_TTL=604800
VECTORIZER_FACTORY=

# 只有指向隔离 Redis Stack 的 URL 和显式开关同时存在时，才运行真实向量集成测试。
RUN_RAG_REDIS_INTEGRATION=0
RAG_REDIS_TEST_URL=
